import java.util.Scanner;

public class Exercicio7Horizontal {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);
        // Novamente, só saída
        for (int i = 1; i <= 20; i++) {
            System.out.print(i);
            if (i < 20) {
                System.out.print(" "); // coloca um espaço entre os números
            }
        }
        System.out.println(); // pula linha no fim
        entrada.close();
    }
}
