import java.util.Scanner;

public class Exercicio10 {
    public static void main(String[] args) {
        Scanner scannerIntervalo = new Scanner(System.in);

        System.out.print("Digite o primeiro número: ");
        int num1 = scannerIntervalo.nextInt();

        System.out.print("Digite o segundo número: ");
        int num2 = scannerIntervalo.nextInt();

        System.out.println("Números no intervalo entre " + num1 + " e " + num2 + ":");

        if (num1 < num2) {
            for (int i = num1 + 1; i < num2; i++) {
                System.out.println(i);
            }
        } else if (num2 < num1) {
            for (int i = num2 + 1; i < num1; i++) {
                System.out.println(i);
            }
        } else {
            System.out.println("Não há intervalo, os números são iguais.");
        }

        scannerIntervalo.close();
    }
}
